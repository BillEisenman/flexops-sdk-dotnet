<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlexOps.Sdk</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>FlexOps.Sdk</PackageId>
    <Version>1.1.0</Version>
    <Authors>FlexOps, LLC</Authors>
    <Company>FlexOps, LLC</Company>
    <Description>Official FlexOps Platform .NET SDK — typed, resource-based client for the multi-carrier shipping API (rates, labels, tracking, returns, webhooks, insurance, wallet, and more).</Description>
    <PackageTags>flexops;shipping;logistics;usps;ups;fedex;dhl;api-client;sdk</PackageTags>
    <RepositoryUrl>https://github.com/BillEisenman/flexops-sdk-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://flexops.io/developers/sdks</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>



</Project>
