  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FlexOps.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../examples/international-label.json" Link="international-label.json" CopyToOutputDirectory="PreserveNewest" />
